# International digits only, no +, spaces, or punctuation. Leave empty until verified.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Optional automatic lead emails. Keep disabled until all delivery checks pass.
LEAD_FORM_ENABLED=false
# Server-only API key from Resend. Never put this in NEXT_PUBLIC_*.
RESEND_API_KEY=
# A plain email address on a domain you have verified for sending in Resend.
LEAD_FROM_EMAIL=
# Optional; defaults to info@aurixtravelslimited.in.
LEAD_NOTIFICATION_EMAIL=
# Public site origin, without a trailing slash. Set to your real deployment URL.
LEAD_SITE_ORIGIN=https://aurixtravelslimited.in
# Cloudflare Turnstile managed widget: site key is public; secret is server-only.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
